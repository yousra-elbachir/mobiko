# Copy to .streamlit/secrets.toml (which is gitignored) and fill in.
# On Streamlit Community Cloud, paste this into the app's Settings → Secrets.

# --- Shared access password (required) ---------------------------------------
# Everyone you share the app link + this password with can log in.
# Alternatively set the ANNOTATION_PASSWORD environment variable (takes
# precedence) — preferred for container/cluster deployments.
app_password = "change-me"

# --- Durable storage on GitHub (optional but REQUIRED on ephemeral hosts) -----
# Needed on hosts whose disk is wiped on restart (e.g. Streamlit Community
# Cloud): the app commits each <task>_<name>_annotated.json to a GitHub branch
# so annotations survive restarts. Omit this section to use local disk only
# (fine on a VM / k8s PVC).
#
# `token` must be a fine-grained Personal Access Token with **Contents: Read
# and write** on THIS repo only. `branch` is a DEDICATED branch the deployment
# does NOT track, so saving annotations never triggers a redeploy.
# [github]
# repo   = "your-org/your-repo"
# token  = "github_pat_xxx"
# branch = "annotations"
# subdir = ""                 # optional path prefix inside the repo
